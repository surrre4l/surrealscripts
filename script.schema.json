
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Surreal Scripts Metadata",
  "description": "Reusable metadata format for any script managed by surrealscripts.ui.",
  "type": "object",
  "required": [
    "schemaVersion",
    "scripts"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "scripts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/script"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "script": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "type",
        "description",
        "visibility",
        "sourceAvailable"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable, unique script identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Flexible category, such as library, utility, hub, or application."
        },
        "description": {
          "type": "string"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ]
        },
        "sourceAvailable": {
          "type": "boolean"
        },
        "sourceUrl": {
          "type": "string"
        },
        "downloadUrl": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^$|^[a-fA-F0-9]{64}$"
        },
        "encryption": {
          "$ref": "#/$defs/encryption"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "metadata": {
          "type": "object",
          "description": "Optional project-specific fields.",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "encryption": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "algorithm": {
          "type": "string",
          "enum": [
            "AES-256-GCM"
          ]
        },
        "keyReference": {
          "type": "string",
          "description": "A reference to a key managed securely elsewhere, never the key itself."
        }
      },
      "required": [
        "enabled",
        "algorithm"
      ],
      "additionalProperties": false
    }
  }
}
